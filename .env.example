TELEGRAM_BOT_TOKEN=123456789:replace_with_token_from_botfather
POLZA_AI_API_KEY=replace_with_key_from_polza_ai

POLZA_AI_BASE_URL=https://api.polza.ai/v1
POLZA_AI_MODEL=openai/gpt-5

# Оставьте пустым, чтобы разрешить всем. Telegram ID перечисляются через запятую.
ALLOWED_USER_IDS=

MEMORY_DIR=memory
